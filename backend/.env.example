# Local development loads the canonical root ../.env.local so Next.js and FastAPI share server config.
# For deployed FastAPI, set these in the backend host's secret manager instead of creating this file.
DATA_VERSION=demo-v1
METHODOLOGY_VERSION=workbook-methodology-unconfirmed
UNIVERSE_DB_PATH=backend/universe.sqlite3
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
