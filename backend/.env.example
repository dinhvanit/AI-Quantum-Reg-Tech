# BACKEND (FastAPI) – local: copy to backend/.env; production: the backend host's env/secret manager (never bake into the image).
# Load order: real process env > backend/.env > root .env.local (legacy fallback). Existing values are never overwritten.

# CORS: comma-separated frontend origins (scheme + host, no trailing slash), e.g. https://<app>.vercel.app
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# OSINT discovery: Firecrawl only. Without a key the scan returns workbook events labelled DEMO DATA.
FIRECRAWL_API_KEY=
# agent (default): one Firecrawl Agent job per ticker (async, usually minutes) returns events with url + verbatim quote;
#   every source page is then re-read (Firecrawl scrape, 1 credit/page, Jina fallback) to check the quote.
#   Cost per ticker ≤ OSINT_AGENT_MAX_CREDITS + up to 20 scraped pages.
# search: 4 penalty queries per ticker; credits per ticker ≈ 4 × (2 + OSINT_FIRECRAWL_LIMIT).
OSINT_DISCOVERY=agent
OSINT_AGENT_MAX_CREDITS=500
OSINT_AGENT_TIMEOUT_SECONDS=300
OSINT_FIRECRAWL_LIMIT=5
OSINT_LOOKBACK_YEARS=3
# Jina Reader: optional fallback when Firecrawl could not read a page. Key only raises rate limits.
OSINT_JINA_FALLBACK=true
JINA_API_KEY=

# AI proposals (OSINT classification + opt-in PDF extraction): groq | gemini.
# OSINT_AI_PROVIDER overrides AI_PROVIDER for the OSINT agent only. Without a matching key: no AI proposals, search results still shown.
AI_PROVIDER=groq
OSINT_AI_PROVIDER=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Neo4j knowledge graph (read-only at runtime). Production: set URI/USERNAME/PASSWORD here.
# Local alternative: NEO4J_CREDENTIALS_FILE=<path outside the repo> instead of copying the password.
NEO4J_ENABLED=true
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
NEO4J_CREDENTIALS_FILE=
# Only for the manual seed command (app.seed_graph). Keep false on the deployed service.
NEO4J_ALLOW_DEMO_WRITE=false

# Licensed daily market history (SSI FastConnect V3; adapter only, needs activated Market Data access). Leave empty for now.
SSI_API_KEY=
SSI_API_SECRET=
SSI_API_BASE_URL=https://api.ssi.com.vn

# Data registry labels
DATA_VERSION=demo-v1
METHODOLOGY_VERSION=workbook-methodology-v1
# SQLite registry for pending_data tickers. Default: backend/universe.sqlite3 (lost on container redeploy).
# To keep it, mount a volume and point here, e.g. /data/universe.sqlite3.
UNIVERSE_DB_PATH=
# JSON from `npm run data`. Default: <repo>/data/generated (the Docker image copies it to /app/data/generated).
GENERATED_DATA_DIR=

# PORT is read by the Docker CMD (default 8000); most hosts inject it automatically.
# OSINT scan jobs live in process memory: run ONE uvicorn worker/instance (Dockerfile default).
