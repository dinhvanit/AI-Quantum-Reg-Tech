# FRONTEND (Next.js) – local: copy to .env.local at the repo root; production: Vercel → Project Settings → Environment Variables.
# Backend/service keys live in backend/.env.example (deployed separately). Never put a service key in NEXT_PUBLIC_*.

# false → pages read through FastAPI; true → pages read data/generated/*.json directly (no backend needed).
# NEXT_PUBLIC_* values are inlined at build time: change them → redeploy the frontend.
NEXT_PUBLIC_USE_MOCK=false

# Public URL of the FastAPI service (no trailing slash). Production: https://<backend-domain>
# Pages are prerendered at build time, so with NEXT_PUBLIC_USE_MOCK=false the backend must be reachable during `next build`.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Server-only URL used by the /api/* proxy routes (OSINT scan, PDF extract, universe). Defaults to NEXT_PUBLIC_API_URL.
# Set it only when the server can reach the backend on a private/internal address.
QUANTUM_API_URL=http://127.0.0.1:8000

# Universe id sent by /api/universe to the backend registry.
UNIVERSE_ID=demo-v1
