# Copy the needed values to .env.local. Never commit .env.local or put service keys in NEXT_PUBLIC_*.

# Frontend and FastAPI proxy
NEXT_PUBLIC_USE_MOCK=false
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
QUANTUM_API_URL=http://127.0.0.1:8000
UNIVERSE_ID=demo-v1

# OSINT search: Firecrawl only (4 penalty queries per ticker: tax, environment, securities, administrative).
# Credits per ticker ≈ 4 × (2 search + OSINT_FIRECRAWL_LIMIT scraped pages).
FIRECRAWL_API_KEY=
OSINT_FIRECRAWL_LIMIT=5
OSINT_LOOKBACK_YEARS=3
# Jina Reader: optional fallback for up to 3 results Firecrawl could not scrape. Key only raises rate limits.
OSINT_JINA_FALLBACK=true
JINA_API_KEY=

# AI classification: groq | gemini. OSINT_AI_PROVIDER overrides AI_PROVIDER for the OSINT agent only.
AI_PROVIDER=groq
OSINT_AI_PROVIDER=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Licensed daily market history (SSI FastConnect V3; requires activated Market Data access)
SSI_API_KEY=
SSI_API_SECRET=
SSI_API_BASE_URL=https://api.ssi.com.vn

# FastAPI data registry
DATA_VERSION=demo-v1
METHODOLOGY_VERSION=workbook-methodology-v1
UNIVERSE_DB_PATH=backend/universe.sqlite3
# Defaults to <repo>/data/generated (output of npm run data). Override only when JSON is mounted elsewhere.
GENERATED_DATA_DIR=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Neo4j knowledge graph. Prefer NEO4J_CREDENTIALS_FILE locally to avoid duplicating a DB password.
NEO4J_ENABLED=true
NEO4J_URI=neo4j+s://<instance-id>.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
NEO4J_CREDENTIALS_FILE=
NEO4J_ALLOW_DEMO_WRITE=false
